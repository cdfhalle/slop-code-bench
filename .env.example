# Copy this file to ~/.config/slop-code/.env and fill in the keys.
# The repo never writes that path. Do not commit secrets.
#
# Batch jobs read the XDG file directly. `load_dotenv()` in the CLI only
# sees a .env in the working directory, not this path. Blank values below
# are ignored by the batch loader, so an empty placeholder does not wipe
# a key that is already in the environment. Values are literal (no $ expansion).

# Optional site overrides. Defaults live in config.sh. Every SCB_* value
# there is env-overridable. SCB_IMAGES_DIR must never equal SCB_IMAGE_STORE.
# Uncommented lines are literal: this loader does not expand $USER.
# Leave a default that contains $USER commented so config.sh can expand it.
# SCB_ACCOUNT=sci-maalej-swe-bench
# SCB_PARTITION=cpu-batch
# SCB_CONSTRAINT=ARCH:X86&SCRATCH:NVME
# SCB_IMAGE_STORE=/sc/projects/sci-maalej/swe-bench/containers/slop-code
# SCB_IMAGES_DIR=/sc/scratch/$USER/slop-code/images
# SCB_RUNS_DIR=
# SCB_PYTHON=
# SCB_ENDPOINT_DIR=
# SCB_SLIRP=
# SCB_MEM=16G
# SCB_CPUS=4
# SCB_TIME=08:00:00

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Not used by the GHCR base bake. A Docker Hub pull has to authenticate
# because the cluster NAT IP's anonymous quota is spent.
DOCKERHUB_USERNAME=
DOCKERHUB_PAT=
